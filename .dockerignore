# Never send credentials or runtime configuration to a Docker build context.
.env
**/.env
**/.env.*
!**/.env.example
secrets/
**/secrets/
runtime_secrets/
failed_updates/
onion-keys/

# Runtime data, local databases, and logs are mounted or generated separately.
api/data/
docker/logs/
logs/
tmp/
temp/
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
**/*.sqlite3
**/*.log

# Generated language/runtime output must not shadow reviewed source files.
**/__pycache__/
**/*.py[cod]
**/*.so
**/.pytest_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.cache/
**/.tox/
**/.nox/
**/.hypothesis/
**/.eggs/
**/*.egg-info/
**/build/
**/dist/
**/env/
**/venv/
**/*.bak
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/.turbo/
web/build/
web/.swc/
web/test-results/
web/playwright-report/
web/tsconfig.tsbuildinfo
web/yarn.lock
web/pnpm-lock.yaml
web/npm-debug.log*
web/yarn-debug.log*
web/yarn-error.log*
web/.pnpm-debug.log*

# Source-control metadata is not an image input.
.git
.trees/
.claude/
.agents/
.codex/
.idea/
.vscode/
.DS_Store
CLAUDE.md
AGENTS.md
claudedocs/
